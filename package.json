{
  "name": "libragent",
  "private": true,
  "version": "0.9.9",
  "description": "A desktop app for AI agents with built-in tools",
  "author": "fritzprix",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fritzprix/libr-agent.git"
  },
  "keywords": [
    "ai",
    "agent",
    "multi-agent",
    "orchestration",
    "mcp",
    "model-context-protocol",
    "react",
    "desktop",
    "shareable-config"
  ],
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20",
    "pnpm": "9.15.9"
  },
  "scripts": {
    "dev": "node scripts/sync-builtin-services.cjs && node scripts/sync-execution-mode.cjs && vite",
    "build": "node scripts/sync-builtin-services.cjs && node scripts/sync-execution-mode.cjs && pnpm build:nosync",
    "build:nosync": "tsc && vite build",
    "perf:bundle": "pnpm tsx scripts/check-bundle-size.ts",
    "sync-builtin-services": "node scripts/sync-builtin-services.cjs && pnpm exec prettier --write --log-level warn src/lib/generated/builtin-services.ts",
    "sync-execution-mode": "node scripts/sync-execution-mode.cjs && pnpm exec prettier --write --log-level warn src/lib/generated/execution-mode.ts",
    "preview": "vite preview",
    "docs:dev": "pnpm --filter libragent-docs dev",
    "docs:build": "pnpm --filter libragent-docs build",
    "docs:preview": "pnpm --filter libragent-docs preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:run:validate": "node scripts/run-vitest-validate.cjs",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write --log-level warn .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\" --ignore-path .prettierignore",
    "format:check:all": "prettier --check .",
    "tauri": "tauri",
    "tauri:mcp": "LIBRAGENT_MCP_ENABLE=1 tauri dev",
    "diagnose": "echo 'System diagnostic...' && ldd --version && echo 'WebKit packages:' && dpkg -l | grep webkit",
    "dead-code": "unimported",
    "dead-code:init": "unimported --init",
    "rust:fmt": "cd src-tauri && cargo fmt",
    "rust:fmt:check": "cd src-tauri && cargo fmt --check",
    "rust:clippy": "node scripts/run-rust-command.cjs clippy -- -D warnings",
    "rust:clippy:all": "node scripts/run-rust-command.cjs clippy --all-features -- -D warnings",
    "rust:check": "node scripts/run-rust-command.cjs check",
    "rust:check:all": "node scripts/run-rust-command.cjs check --all-features",
    "rust:test": "node scripts/run-rust-command.cjs test --tests --profile ci-test",
    "rust:test:edit-file": "node scripts/run-rust-command.cjs test --tests --profile ci-test --no-default-features --features workspace-edit-file",
    "rust:clean": "cd src-tauri && cargo clean",
    "rust:validate": "pnpm rust:fmt && pnpm rust:clippy:all",
    "assistants:validate": "node scripts/validate-assistant-skills.cjs",
    "skills:audit": "node scripts/audit-bundled-skills.cjs",
    "skills:mirror:check": "node scripts/check-skills-mirror-drift.cjs",
    "tool-names:check": "node scripts/check-obsolete-tool-names.cjs",
    "skill:validate": "python .agents/skills/skill-creator/scripts/validate_skill.py",
    "skill:package": "python .agents/skills/skill-creator/scripts/package_skill.py",
    "refactor:prepare": "node scripts/refactor-pipeline.js prepare",
    "refactor:validate": "node scripts/refactor-pipeline.js validate",
    "refactor:validate:legacy": "pnpm refactor:prepare && pnpm lint && pnpm test:run:validate && pnpm rust:clippy && pnpm rust:check:all && pnpm rust:test && pnpm build && pnpm perf:bundle && pnpm dead-code",
    "verify-planning": "node scripts/manage-logs.js --pattern=\"PLANNING\" -n=5000",
    "verify-planning:file": "node scripts/manage-logs.js --pattern=\"PLANNING\" -n=5000",
    "log": "node scripts/manage-logs.js",
    "error": "node scripts/manage-logs.js --error",
    "release": "bash scripts/release.sh",
    "preinstall": "node scripts/enforce-pnpm-version.cjs",
    "prepare": "node scripts/setup-git-hooks.cjs",
    "lockfile:check": "pnpm install --frozen-lockfile",
    "bench:hello": "node scripts/run-harbor-bench.cjs --preset hello",
    "bench:terminal": "node scripts/run-harbor-bench.cjs --preset terminal-bench --n-tasks 1",
    "bench:terminal:all": "node scripts/run-harbor-bench.cjs --preset terminal-bench",
    "bench:harbor": "node scripts/run-harbor-bench.cjs --preset harbor-index --n-tasks 1",
    "bench:harbor:all": "node scripts/run-harbor-bench.cjs --preset harbor-index",
    "bench:registry": "node scripts/run-harbor-bench.cjs --preset dataset",
    "bench:diverse": "node scripts/run-harbor-bench.cjs --preset dataset --dataset fritzprix/libragent-diverse-9",
    "bench:diverse:n1": "node scripts/run-harbor-bench.cjs --preset dataset --dataset fritzprix/libragent-diverse-9 --n-tasks 1",
    "bench:fileop": "node scripts/run-harbor-bench.cjs --preset dataset --dataset NovitaAI/tb21-file-recovery",
    "bench:fileop:n1": "node scripts/run-harbor-bench.cjs --preset dataset --dataset NovitaAI/tb21-file-recovery --n-tasks 1",
    "bench:upload": "node scripts/upload-harbor-bench.cjs",
    "bench:termial": "pnpm bench:terminal",
    "bench:termial:all": "pnpm bench:terminal:all",
    "xbench:registry": "node scripts/run-harbor-bench.cjs --agent hermes --preset dataset",
    "xbench:terminal": "node scripts/run-harbor-bench.cjs --agent hermes --preset terminal-bench --n-tasks 1",
    "xbench:terminal:all": "node scripts/run-harbor-bench.cjs --agent hermes --preset terminal-bench",
    "xbench:harbor": "node scripts/run-harbor-bench.cjs --agent hermes --preset harbor-index --n-tasks 1",
    "xbench:harbor:all": "node scripts/run-harbor-bench.cjs --agent hermes --preset harbor-index",
    "bench:hermes:registry": "node scripts/run-harbor-bench.cjs --agent hermes --preset dataset"
  },
  "pnpm": {
    "overrides": {
      "punycode": "^2.3.1"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.64.0",
    "@cerebras/cerebras_cloud_sdk": "^1.64.1",
    "@google/genai": "^1.10.0",
    "@hypothesi/tauri-plugin-mcp-bridge": "^0.9.0",
    "@mcp-ui/client": "^5.6.2",
    "@mcp-ui/server": "^5.2.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@remote-dom/core": "^1.9.0",
    "@tauri-apps/api": "^2.10.0",
    "@tauri-apps/plugin-dialog": "^2.5.0",
    "@tauri-apps/plugin-http": "^2.5.0",
    "@tauri-apps/plugin-log": "^2.8.0",
    "@tauri-apps/plugin-updater": "^2.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fast-deep-equal": "^3.1.3",
    "groq-sdk": "^1.1.2",
    "handlebars": "^4.7.8",
    "i18next": "^23.15.1",
    "i18next-browser-languagedetector": "^8.0.0",
    "immer": "^10.1.1",
    "katex": "^0.16.27",
    "lucide-react": "^0.526.0",
    "next-themes": "^0.4.6",
    "ollama": "^0.6.3",
    "openai": "^5.9.0",
    "postcss": "^8.5.6",
    "prism-react-renderer": "^2.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.7.1",
    "react-use": "^17.6.0",
    "react-virtuoso": "^4.18.6",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sonner": "^2.0.6",
    "swr": "^2.3.4",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.11",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@tailwindcss/postcss": "^4.1.11",
    "@tailwindcss/vite": "^4.1.11",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^24.0.13",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "8",
    "@typescript-eslint/parser": "8",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "html-validate": "^10.2.1",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.3.6",
    "typescript": "~5.6.2",
    "unimported": "^1.31.1",
    "vite": "^6.0.3",
    "vite-plugin-top-level-await": "^1.6.0",
    "vite-plugin-wasm": "^3.5.0",
    "vitest": "^3.2.4"
  }
}
