{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LibrAgent",
  "version": "0.9.9",
  "identifier": "com.fritzprix.libragent",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LibrAgent - AI agents with built-in tools",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "theme": "Light"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$RESOURCE/**",
          "workspace/**"
        ]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3QjY3NEE1NTI5OUM0NjYKUldSbXhKbFNwWFMyeDlNelA5ZHg1ME9tNlQ0YW13bHA3ZHpVL1M2UERRVEVzSmk4RXhsV2xxWm0K",
      "endpoints": [
        "https://github.com/fritzprix/libr-agent/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": [
      "bundled_skills/**/*",
      "bundled_assistants/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "libssl-dev",
          "libgstreamer1.0-0",
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-plugins-ugly",
          "gstreamer1.0-libav",
          "gstreamer1.0-alsa",
          "gstreamer1.0-gl",
          "gstreamer1.0-gtk3",
          "gstreamer1.0-pulseaudio"
        ]
      }
    },
    "macOS": {
      "signingIdentity": null,
      "minimumSystemVersion": "10.15",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true
    }
  }
}
